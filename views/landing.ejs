<%- include('partials/head', { title: 'AI Marketing Studio', page: 'landing' }) %>

<div id="landing-page">
    <div class="glow-bubble glow-bubble-1"></div>
    <div class="glow-bubble glow-bubble-2"></div>

    <%- include('partials/landing-nav') %>

    <!-- HERO -->
    <section class="hero-section">
        <div class="hero-badge">
            <span class="badge badge-primary">✨ Free for Everyone — No Credit Card Required</span>
        </div>
        <h1 class="hero-title">
            Generate Professional <span class="gradient-text">Marketing Content</span> with AI
        </h1>
        <p class="hero-subtitle">
            Upload your product once and instantly generate beautiful advertising visuals, social media posts, captions and marketing content powered by Artificial Intelligence.
        </p>
        <div class="hero-actions">
            <a href="/auth?tab=register" class="btn btn-primary btn-lg">Get Started Free</a>
            <a href="#features" class="btn btn-secondary btn-lg">Explore Features</a>
        </div>

        <!-- Before / After Showcase -->
        <div class="showcase-container">
            <div class="showcase-side showcase-side-left">
                <span class="showcase-label">Raw Photo</span>
                <img src="/assets/perfume_raw.png" alt="Raw Product Photo">
            </div>
            <div class="showcase-divider">
                <div class="showcase-divider-line"></div>
                <div class="showcase-divider-arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 4.5l7.5 7.5-7.5 7.5m-6-15l7.5 7.5-7.5 7.5" />
                    </svg>
                </div>
                <div class="showcase-divider-line"></div>
            </div>
            <div class="showcase-side showcase-side-right">
                <span class="showcase-label">AI Studio Render</span>
                <img src="/assets/perfume_studio.png" alt="AI Generated Studio Ad">
            </div>
        </div>
    </section>

    <!-- FEATURES -->
    <section class="features-section" id="features">
        <div class="section-header">
            <span class="badge badge-primary">Capabilities</span>
            <h2 class="section-title">Everything you need to scale</h2>
            <p class="section-subtitle">Generate hyper-realistic product shoots and ready-to-publish copies in seconds.</p>
        </div>
        <div class="features-grid">
            <div class="card feature-card card-hover">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" /><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z" /></svg>
                </div>
                <h3>AI Image Studio</h3>
                <p>No expensive cameras or studio hires. Place your product in any ambient setting dynamically.</p>
            </div>
            <div class="card feature-card card-hover">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" /></svg>
                </div>
                <h3>AI Post Writer</h3>
                <p>Professional copywriter in your pocket. Optimized for Instagram, LinkedIn, TikTok, and Facebook.</p>
            </div>
            <div class="card feature-card card-hover">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z" /><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z" /></svg>
                </div>
                <h3>Analytics Dashboard</h3>
                <p>Track generation history, templates performance and full workspace activity insights.</p>
            </div>
            <div class="card feature-card card-hover">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6z" /><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6z" /><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25z" /></svg>
                </div>
                <h3>Smart Templates</h3>
                <p>Pre-built professional templates for cosmetics, tech, fashion and food products.</p>
            </div>
            <div class="card feature-card card-hover">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" /></svg>
                </div>
                <h3>Multi-Language</h3>
                <p>Generate content in English, French, and Arabic to reach global audiences easily.</p>
            </div>
            <div class="card feature-card card-hover">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                </div>
                <h3>Instant Download</h3>
                <p>Every generated asset is available for immediate download in full resolution.</p>
            </div>
        </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="testimonials-section" id="testimonials">
        <div class="section-header">
            <span class="badge badge-primary">Reviews</span>
            <h2 class="section-title">Loved by Brands Worldwide</h2>
        </div>
        <div class="testimonials-grid">
            <div class="card testimonial-card">
                <p class="testimonial-text">"We reduced our studio budget by 80% using AI Marketing Studio. The renders look identical to real photoshoot setups."</p>
                <div class="testimonial-author">
                    <div style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--secondary));display:flex;align-items:center;justify-content:center;color:white;font-weight:700;">S</div>
                    <div class="testimonial-info">
                        <h4>Sarah Jenkins</h4>
                        <span>Founder, PureSkin Cosmetics</span>
                    </div>
                </div>
            </div>
            <div class="card testimonial-card">
                <p class="testimonial-text">"Instantly drafting marketing posts in French and English saved us hours of agency coordination. Simply brilliant."</p>
                <div class="testimonial-author">
                    <div style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#00b395);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;">M</div>
                    <div class="testimonial-info">
                        <h4>Marc-Antoine</h4>
                        <span>Marketing Lead, ChronoVibe</span>
                    </div>
                </div>
            </div>
            <div class="card testimonial-card">
                <p class="testimonial-text">"Just clicked a luxury template, uploaded a photo, and had our Instagram post ready within seconds. Game changer."</p>
                <div class="testimonial-author">
                    <div style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#FF6B6B,#FFB347);display:flex;align-items:center;justify-content:center;color:white;font-weight:700;">A</div>
                    <div class="testimonial-info">
                        <h4>Alex Rivera</h4>
                        <span>Creative Director, ApexAudio</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section" id="faq">
        <div class="section-header">
            <span class="badge badge-primary">FAQ</span>
            <h2 class="section-title">Frequently Asked Questions</h2>
        </div>
        <div class="faq-list">
            <div class="faq-item">
                <div class="faq-question">
                    <span>Is it really free? No hidden costs?</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                </div>
                <div class="faq-answer">
                    <div class="faq-answer-inner">Yes, completely free. Just create an account with your email and start generating professional marketing content immediately. No credit card needed, no hidden charges.</div>
                </div>
            </div>
            <div class="faq-item">
                <div class="faq-question">
                    <span>How does the AI image generator work?</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                </div>
                <div class="faq-answer">
                    <div class="faq-answer-inner">Upload a photo of your product, select a style and background preset, write a short prompt, and press Generate. Our AI places your product in a professional studio setting with custom lighting and shadows.</div>
                </div>
            </div>
            <div class="faq-item">
                <div class="faq-question">
                    <span>Can I use generated content commercially?</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                </div>
                <div class="faq-answer">
                    <div class="faq-answer-inner">Absolutely. All content generated through AI Marketing Studio is fully owned by you and cleared for worldwide commercial use — social media ads, websites, print and more.</div>
                </div>
            </div>
            <div class="faq-item">
                <div class="faq-question">
                    <span>Which languages are supported for copy generation?</span>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                </div>
                <div class="faq-answer">
                    <div class="faq-answer-inner">We currently support English, French, and Arabic with full character support. More languages are coming soon based on user demand.</div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Banner -->
    <section style="max-width:900px;margin:0 auto 8rem auto;padding:0 2rem;text-align:center;">
        <div class="card card-glass" style="padding:4rem 3rem;">
            <h2 class="section-title">Ready to transform your marketing?</h2>
            <p class="section-subtitle" style="margin-bottom:2rem;">Join thousands of brands already using AI to generate stunning visuals and copy — completely free.</p>
            <a href="/auth?tab=register" class="btn btn-primary btn-lg">Create Free Account</a>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="landing-footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <a href="/" class="footer-logo">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 21l8.982-11.825a.9.9 0 00-1.347-1.17l-5.94 4.028a.9.9 0 01-1.17-.187l-3.51-3.51A.9.9 0 004.5 9.75h5.313" /></svg>
                    <span>AI Marketing Studio</span>
                </a>
                <p>Instant studio assets generation for modern e-commerce businesses worldwide.</p>
            </div>
            <div class="footer-links">
                <h4>Product</h4>
                <ul>
                    <li><a href="#features">Features</a></li>
                    <li><a href="/auth?tab=register">Create Account</a></li>
                    <li><a href="#faq">FAQ</a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h4>Legal</h4>
                <ul>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Terms of Use</a></li>
                </ul>
            </div>
            <div class="footer-links">
                <h4>Account</h4>
                <ul>
                    <li><a href="/auth">Login</a></li>
                    <li><a href="/auth?tab=register">Register</a></li>
                    <% if (user) { %><li><a href="/dashboard">Dashboard</a></li><% } %>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© 2026 AI Marketing Studio. All rights reserved.</span>
            <span>Built with Node.js & Express</span>
        </div>
    </footer>
</div>

<script>
// FAQ Accordion
document.querySelectorAll('.faq-question').forEach(q => {
    q.addEventListener('click', () => q.parentElement.classList.toggle('active'));
});

// Theme toggle on landing
const html = document.documentElement;
const savedTheme = localStorage.getItem('theme') || 'light';
html.setAttribute('data-theme', savedTheme);
</script>
</body>
</html>
